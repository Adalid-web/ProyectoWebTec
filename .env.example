# Copia este archivo como .env y cambia la contraseña antes de ejecutar.
# .env está ignorado por Git y no debe subirse al repositorio.

API_CONTAINER_NAME=proyectotecweb-api
API_PORT=8080
APP_PUBLIC_URL=http://localhost:8080

DOCKERHUB_USER=nardolj
IMAGE_NAME=proyectowebtec
IMAGE_TAG=1.0.0

POSTGRES_CONTAINER_NAME=proyectotecweb-db
POSTGRES_HOST=postgres
POSTGRES_DB=proyectotecweb
POSTGRES_USER=proyectotecweb
POSTGRES_PASSWORD=cambia_esta_clave

# OAuth de Leonardo (Bolivia). Completar solo en .env, nunca en este archivo.
# Google: https://console.cloud.google.com/  -> callback http://localhost:8080/signin-google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord: https://discord.com/developers/applications -> callback http://localhost:8080/signin-discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# OAuth de los compañeros (se completan cuando integren sus proveedores).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
